# /etc/de-trainer/env — owner root, mode 600
APP_ENV=prod
HOST=127.0.0.1
PORT=8080
DATA_DIR=/var/lib/de-trainer
ACCESS_TEAM_DOMAIN=https://<team>.cloudflareaccess.com
# AUD tag of the Access application on de-class.vta.dev/api and /auth (comma-separated if several)
ACCESS_AUD_USER=
# AUD tag of the Access application on de-class.vta.dev/agent
ACCESS_AUD_AGENT=
LOG_LEVEL=info
