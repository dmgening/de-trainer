# Copy to .env next to compose.yaml on the host. The AUD tags for
# de-class.vta.dev: `tofu -chdir=tofu/cloudflare output de_class` in the homelab.
DE_CLASS_IMAGE=ghcr.io/dmgening/de-trainer:sha-0000000
DE_CLASS_HOST=de-class.vta.dev
ACCESS_TEAM_DOMAIN=https://vtanet.cloudflareaccess.com
ACCESS_AUD_USER=<AUD de-class owner>
ACCESS_AUD_AGENT=<AUD de-class agent>
LOG_LEVEL=info
